# =============================================================================
#  Шаблон переменных окружения для task6.
#  Скопируйте в .env и при необходимости поменяйте значения.
#  Файл .env в git НЕ коммитится (см. .gitignore).
# =============================================================================

# ---------- PostgreSQL ----------
# БД приложения — `api`. Вторая БД `litellm` создаётся init-скриптом
# init-db/01-create-litellm-db.sql при первой инициализации volume.
POSTGRES_USER=apiuser
POSTGRES_PASSWORD=apipass
POSTGRES_DB=api

# ---------- LiteLLM ----------
# Мастер-ключ (админский) — используется для входа в админку LiteLLM
# (http://localhost:4000/ui) и для выпуска клиентских ключей.
LITELLM_MASTER_KEY=sk-master-changeme-0000000000000000

# Соль для шифрования ключей в БД. После первого старта НЕ менять —
# иначе все сохранённые ключи станут нечитаемыми.
LITELLM_SALT_KEY=changeme-salt-0000000000000000

# ---------- Open WebUI ----------
# Ключ подписи сессий в интерфейсе Open WebUI (любая случайная строка).
WEBUI_SECRET_KEY=changeme-webui-secret-0000000000000000

# Виртуальный ключ для Open WebUI. Создаётся позже через API LiteLLM,
# пока оставляем пустым — зададим после первого запуска.
OPENWEBUI_VIRTUAL_KEY=

# ---------- Redis (кэш отчёта; в local — контейнер, в dev/prod — служба хоста) ----------
API_REDIS_HOST=redis
API_REDIS_PORT=6379

# ---------- Ollama ----------
# Базовая модель для `make model-pull` / `make model-setup`.
# Для Claude Code подходит qwen2.5-coder:7b: влезает в 8 ГБ VRAM
# (ноутбук RTX 4070) вместе с KV-кешем 32k контекста.
OLLAMA_MODEL=qwen2.5-coder:7b

# ---------- LiteLLM: алиас модели ----------
# Клиенты Open WebUI / Aider / Continue обращаются к LiteLLM по этому имени.
# Claude Code этот алиас не использует (идёт в Ollama на claude-local).
DEFAULT_MODEL_ALIAS=local

# ---------- LiteLLM: строка подключения к БД ----------
# LiteLLM хранит ключи и расходы в отдельной базе `litellm` того же Postgres.
# Хост `db` резолвится Docker DNS внутри сети llm-net.
LITELLM_DATABASE_URL=postgresql://apiuser:apipass@db:5432/litellm