# =============================================================================
#  Overlay-модель claude-local для Claude Code CLI.
#
#  Ollama создаёт новую модель поверх базовой (FROM), не копируя веса заново:
#    docker exec ollama ollama create claude-local -f /tmp/Modelfile
#
#  База — mistral-nemo:12b (7.1 ГБ): из опробованных 8–14B именно она отдаёт
#  структурированные tool_use, которые Claude Code исполняет как Bash/Read/Grep.
#  qwen2.5-coder:7b и llama3.1:8b печатали вызовы инструментов текстом.
#
#  num_ctx 4096 — окно контекста. На 8 ГБ VRAM (ноутбук RTX 4070) больше
#  не влезает: модель + KV-кеш 8k/16k уйдут в CPU и станут медленными.
#  Модель всё равно частично уходит на CPU (27%/73%), но работает.
#  temperature 0.1 — меньше фантазии в аргументах инструментов.
# =============================================================================
FROM mistral-nemo:12b
PARAMETER num_ctx 4096
PARAMETER temperature 0.1