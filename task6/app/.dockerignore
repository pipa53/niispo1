__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db

# Docker: сам Dockerfile и этот файл в образ не нужны
Dockerfile
.dockerignore
