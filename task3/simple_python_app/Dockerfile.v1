# v1 — «наивный» Dockerfile. Контекст ~40 MB (весь каталог, включая venv),
# образ ~441 MB. COPY . идёт ДО установки пакетов: любая правка кода
# инвалидирует кеш слоёв pip. Кеш apt/pip не чистится.
FROM python:3.12.1

# Копирование кода приложения
COPY . /app/

# Установка системных зависимостей для сборки зависимостей python
RUN apt-get update \
    && apt-get install -y gcc libpq-dev

# Установка зависимостей python
RUN pip install -r /app/requirements.txt

# Установка рабочей директории
WORKDIR /app

# 0.0.0.0 — слушать все интерфейсы контейнера, иначе порт с хоста не достучится
CMD ["uvicorn", "app:app", "--host", "0.0.0.0"]
