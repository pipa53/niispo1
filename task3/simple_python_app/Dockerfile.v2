# v2 — тот же размер (~441 MB), но быстрее пересборка: сначала редкие слои
# (apt, requirements.txt, pip), потом COPY кода. Правка app.py не гоняет pip.
FROM python:3.12.1

# -- Редко изменяемые операции --
# Установка системных зависимостей (в т.ч. для сборки psycopg2)
RUN apt-get update \
    && apt-get install -y gcc libpq-dev

# Копирование только файла зависимостей (меняется редко)
COPY requirements.txt /app/

# Установка зависимостей python (долгий шаг, кешируется)
RUN pip install -r /app/requirements.txt

# -- Часто изменяемые операции --
# Копирование кода приложения
COPY . /app/

# Установка рабочей директории
WORKDIR /app

# 0.0.0.0 — слушать все интерфейсы контейнера, иначе порт с хоста не достучится
CMD ["uvicorn", "app:app", "--host", "0.0.0.0"]
