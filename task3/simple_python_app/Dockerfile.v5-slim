# v5-slim — multi-stage: компиляция колёс в полном python, рантайм — slim.
# gcc остаётся только в builder и не попадает в финальный слой. ~64.4 MB.
# ============ STAGE 1: builder ============
FROM python:3.12.1 AS builder

# -- Медленные операции --
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Собираем колёса (.whl) для всех зависимостей в /app/wheels
RUN --mount=type=bind,source=requirements.txt,target=/app/requirements.txt \
    pip wheel --no-cache-dir --no-deps -r /app/requirements.txt --wheel-dir /app/wheels

# ============ STAGE 2: финальный образ ============
FROM python:3.12.1-slim

# Копируем собранные колёса из builder
COPY --from=builder /app/wheels /wheels

# Устанавливаем только рантайм-зависимости (libpq — без dev-заголовков)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Ставим python-пакеты из готовых колёс, не пересобирая
RUN pip install --no-cache-dir /wheels/*

# Копируем код приложения
COPY app.py /app/

WORKDIR /app

# 0.0.0.0 — слушать все интерфейсы контейнера, иначе порт с хоста не достучится
CMD ["uvicorn", "app:app", "--host", "0.0.0.0"]
